config ALONZO_FR8016_SWD_SELFTEST
	bool "FR8016HA SWD self-test (Phase 1-4 bring-up)"
	default n
	help
	  Replace the ble.bin update path with an SWD bring-up self-test: reset
	  the FR8016HA SWD line, read its DPIDR, power up the debug domain, read
	  the MEM-AP IDR, halt the Cortex-M3 core, read PC/SP/xPSR and run it
	  again, then parse and validate the external FR8010H.FLM from the TF card.
          Intended only for hardware bring-up of the SWD master; 
          Keep disabled in production!!!

config ALONZO_FR8016_RAM_BASE
	hex "FR8016HA SRAM base for the FLM work area"
	default 0x20000000
	help
	  Base of the FR8016HA SRAM window used to run the vendor .FLM flash
	  algorithm (code + data + BKPT stub + one 256-byte page buffer + stack).
	  The FLM is ROPI/RWPI so it runs at any RAM address; this just has to be
	  real, writable FR8016HA SRAM.

	  Per the FR801xH SDK User Guide: FR8016HA SRAM base = 0x20000000.

config ALONZO_FR8016_RAM_SIZE
	hex "FR8016HA SRAM size available for the FLM work area (bytes)"
	default 0xC000
	help
	  Size of the FR8016HA SRAM window reserved for the FLM work area. Must be
	  at least ~4 KB (the current FR8010H.FLM needs ~2.7 KB of code/data/BKPT
	  plus a 512-byte stack and a 256-byte page buffer).

	  Per the FR801xH SDK User Guide: FR8016HA SRAM size = 48 KB = 0xC000,
	  range 0x20000000 .. 0x2000BFFF (0x2000C000 is the exclusive end).

source "Kconfig.zephyr"
